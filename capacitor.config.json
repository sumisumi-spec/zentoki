{
  "appId": "app.zentoki",
  "appName": "ZENTOKI",
  "webDir": "www",
  "backgroundColor": "#000000",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#000000",
    "preferredContentMode": "mobile",
    "scheme": "ZENTOKI"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#000000",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#000000"
    },
    "LocalNotifications": {
      "iconColor": "#FFFFFF",
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}